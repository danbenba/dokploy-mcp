# Copy to .env, fill the two secrets, then run: docker compose up -d

# openssl rand -base64 32
APP_KEY=

# openssl rand -base64 48
# Rotating this invalidates every issued access and refresh token.
TOKEN_SECRET=

# Public address of the MCP server, the URL users paste into Claude or ChatGPT
PUBLIC_URL=https://mcp.dokploy.rest

# Public address of the web UI serving the login and consent screens
WEB_URL=https://dokploy.rest

BRAND_NAME=Dokploy MCP

# Name given to the API keys this connector creates on a user's panel
API_KEY_LABEL=Dokploy MCP

ACCESS_TOKEN_TTL=3600
REFRESH_TOKEN_TTL=2592000

# Restrict the deployment to a single Dokploy panel. Users then skip the
# server-address step and can only authenticate against this instance.
# DOKPLOY_LOCKED_URL=https://panel.example.com

# Keep this false in production: it disables the guard that stops the server
# from being pointed at private addresses.
ALLOW_PRIVATE_NETWORKS=false

# Panels reached over plain http are accepted, and the sign-in screens say so.
# Set this to false to accept https panels only.
ALLOW_INSECURE_DOKPLOY=true

LOG_LEVEL=info
