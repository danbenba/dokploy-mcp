# ── HTTP / OAuth mode (dokploy-mcp serve) ─────────────────────────────────────

# Port and bind address of the MCP server
PORT=3010
HOST=0.0.0.0

# Public URL of THIS MCP server (what users paste into Claude/ChatGPT)
# e.g. https://mcp.dokploy.rest
PUBLIC_URL=http://localhost:3010

# Public URL of the web UI (landing + authorization pages)
# e.g. https://dokploy.rest
WEB_URL=http://localhost:5173

# Secret used to sign/encrypt every token (sessions, codes, access/refresh).
# REQUIRED in production: 32+ random characters. Rotating it revokes everything.
# Generate one: openssl rand -base64 48
JWT_SECRET=

# Token lifetimes (seconds)
ACCESS_TOKEN_TTL=3600
REFRESH_TOKEN_TTL=2592000
AUTH_CODE_TTL=120
FLOW_SESSION_TTL=600

# Lock the connector to a single Dokploy panel. When set, users skip the
# "server URL" step and can only authenticate against this instance.
# DOKPLOY_LOCKED_URL=https://panel.example.com

# Allow users to connect Dokploy panels on private/loopback addresses
# (disable SSRF guard — only for self-hosted setups behind a VPN)
ALLOW_PRIVATE_NETWORKS=false

# Allow plain-http Dokploy panels (default requires https)
ALLOW_INSECURE_DOKPLOY=false

# Display name shown on the authorization pages
BRAND_NAME=Dokploy MCP

# Behind a reverse proxy (Traefik/Dokploy), keep true so client IPs are correct
TRUST_PROXY=true

# Rate limit for auth endpoints (per IP)
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=60

# ── stdio / npx mode (dokploy-mcp with no arguments) ──────────────────────────

# DOKPLOY_URL=https://panel.example.com
# DOKPLOY_API_KEY=generated in Dokploy under Settings > API Keys
