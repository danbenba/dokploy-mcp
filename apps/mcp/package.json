{
  "name": "dokploy-mcp",
  "version": "0.1.0",
  "description": "MCP server for Dokploy: connect Claude or ChatGPT to any self-hosted Dokploy instance over a public OAuth URL, locally over stdio, or via npx.",
  "license": "Apache-2.0",
  "type": "module",
  "bin": {
    "dokploy-mcp": "dist/cli.js"
  },
  "main": "dist/cli.js",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsx src/cli.ts serve",
    "start": "node dist/cli.js serve",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.17.0",
    "express": "^4.21.2",
    "jose": "^5.9.6",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.5",
    "tsup": "^8.3.5",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  },
  "keywords": [
    "dokploy",
    "mcp",
    "model-context-protocol",
    "oauth",
    "claude",
    "chatgpt"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/danbenba/dokploy-mcp"
  }
}
