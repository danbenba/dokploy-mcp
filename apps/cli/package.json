{
  "name": "dokploy-mcp",
  "version": "0.1.0",
  "description": "MCP server for Dokploy: give Claude or ChatGPT control of your self-hosted Dokploy panel over stdio.",
  "license": "Apache-2.0",
  "type": "module",
  "bin": {
    "dokploy-mcp": "dist/cli.js"
  },
  "main": "dist/cli.js",
  "files": [
    "dist",
    "README.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsx src/cli.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@dokploy-mcp/core": "*",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "tsup": "^8.3.5",
    "tsx": "^4.19.2",
    "typescript": "~5.8",
    "vitest": "^2.1.8"
  },
  "keywords": [
    "dokploy",
    "mcp",
    "model-context-protocol",
    "claude",
    "chatgpt",
    "devops",
    "paas",
    "deployment"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/danbenba/dokploy-mcp.git",
    "directory": "apps/cli"
  },
  "homepage": "https://dokploy.rest"
}
